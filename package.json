{
  "name": "firsat-radari",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --import tsx apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "demo": "FR_DEMO=1 FR_DATA_DIR=.local/demo npm run dev",
    "build": "vite build --config apps/web/vite.config.ts && esbuild apps/server/src/index.ts apps/server/src/app.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "NODE_ENV=production node dist/server/index.js",
    "start:demo": "FR_DEMO=1 FR_DATA_DIR=.local/demo npm start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit tests/ui",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "bench": "node --import tsx tests/bench/opportunities.ts",
    "test:ui": "vitest run tests/ui",
    "format": "prettier --write apps packages tests scripts *.ts *.js *.json",
    "licenses": "node --import tsx scripts/license-inventory.ts",
    "format:check": "prettier --check apps packages tests scripts *.ts *.js *.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.104.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "iconv-lite": "^0.7.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
